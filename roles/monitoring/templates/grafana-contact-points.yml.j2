apiVersion: 1

contactPoints:
  - orgId: 1
    name: MSP Telegram Alerts
    receivers:
      - uid: telegram_msp
        type: telegram
        settings:
          bottoken: "{{ vault_telegram_bot_token | default('CHANGE_ME') }}"
          chatid: "{{ vault_telegram_chat_id | default('CHANGE_ME') }}"
          message: |
            🚨 *MSP Alert*

            Cliente: {{ "{{ .CommonLabels.client }}" }}
            Entorno: {{ "{{ .CommonLabels.environment }}" }}
            Host: {{ "{{ .CommonLabels.instance }}" }}
            Servicio: {{ "{{ .CommonLabels.service }}" }}
            Severidad: {{ "{{ .CommonLabels.severity }}" }}

            Estado: {{ "{{ .Status }}" }}
            Alerta: {{ "{{ .CommonLabels.alertname }}" }}

            Descripción:
            {{ "{{ .CommonAnnotations.description }}" }}
