global:
  scrape_interval: {{ prometheus_scrape_interval | default('15s') }}

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["prometheus:9090"]

  - job_name: "node-exporter"
    static_configs:
      - targets: ["{{ ansible_host }}:{{ node_exporter_port | default(9100) }}"]

  - job_name: "cadvisor"
    scrape_interval: {{ cadvisor_scrape_interval | default('30s') }}
    scrape_timeout: {{ cadvisor_scrape_timeout | default('25s') }}
    static_configs:
      - targets: ["{{ ansible_host }}:{{ cadvisor_port | default(8088) }}"]
